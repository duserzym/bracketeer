{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bracketeer",
  "version": "0.1.1",
  "identifier": "org.bracketeer.desktop",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRThGODY1MTdGMkRCQUUKUldTdTIvSVhaZmpvVzdrUEw5VUZYaE9lVCs3K2FUWUc3ZU5UU0hQZ2VJVU13cTVMWGZUdmwwbGsK",
      "endpoints": [
        "https://github.com/duserzym/bracketeer/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "build": {
    "frontendDist": "../dist/tauri",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "pnpm dev --host 127.0.0.1 --port 4173 --strictPort"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bracketeer",
        "width": 1280,
        "height": 800,
        "center": true,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#f3f5f4"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Standard-bracketed LA-ICP-MS run sequences for Qtegra",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
