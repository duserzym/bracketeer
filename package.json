{
  "name": "bracketeer",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "updater:setup": "node scripts/setup-updater.mjs",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "build": "vite build",
    "build:desktop": "vite build --outDir dist/tauri --emptyOutDir",
    "build:web": "vite build --mode singlefile && mv dist/.singlefile/index.html dist/bracketeer.html && rmdir dist/.singlefile",
    "fixtures:synthetic": "python3 fixtures/make_sessions.py && node --import tsx scripts/make-fixture-project.ts && python3 fixtures/verify.py > fixtures/verify.txt"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "svelte": "^5.57.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
